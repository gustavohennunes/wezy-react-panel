VITE_APP_NAME=metronic-tailwind-react
VITE_APP_VERSION=1=9.1.1
GENERATE_SOURCEMAP=false

## JWT auth api
## global url https://preview.keenthemes.com/hero-api/api
## local url http://127.0.0.1:8000/api
VITE_APP_API_URL=https://preview.keenthemes.com/hero-api/api
# API PADRÃO (LOGIN CENTRAL /auth/master E TUDO ANTES DE LOGAR): O br-1. O LOGIN DEVOLVE A API DO SERVIDOR DO PAINEL
# DO USUÁRIO (br-1 / us-1) E AS CHAMADAS SEGUINTES VÃO PARA ELA (VER src/utils/apiUrl.js)
VITE_CAYMAN_API_URL=https://api.br-1.wezy.com.br/api/v1
VITE_CAYMAN_API_URL_LOGIN=https://api.br-1.wezy.com.br/api/v1/panel/login
VITE_CAYMAN_API_URL_REGISTER=https://api.br-1.wezy.com.br/api/v1/panel/signup
# ARQUIVOS DO PAINEL LEGADO (css/icons.css, imagens/, fotos): OS HOSTS api.* SÓ RESPONDEM /api/v1
VITE_LEGACY_ORIGIN=https://painel.wezy.com.br
VITE_CUSTOMER_HOST=wezy.com.br
VITE_PANEL_LOGO=https://www.cayman.com.br/imagens/logo.svg

# PÁGINA INICIAL POR CLIENTE (Customer-Host): ABERTA AO LOGAR OU EM "/" SEM ?pag=. SEM ENTRADA, ?pag=dashboard.
# FORMATO: dominio=destino;dominio=destino
VITE_START_PAGES=wezy.com.br=/?pag=clientes&parametro=filtrar-ativos
